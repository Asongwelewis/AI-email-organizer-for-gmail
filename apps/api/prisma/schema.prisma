generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // The long-running API and migrations share the IPv4-compatible session pooler URL.
  directUrl = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?      @db.Uuid
  session_id String?      @db.Uuid
  action     String
  result     audit_result @default(INFO)
  request_id String?
  metadata   Json         @default("{}")
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  sessions   sessions?    @relation(fields: [session_id], references: [id])
  users      users?       @relation(fields: [user_id], references: [id])

  @@index([action])
  @@index([created_at(sort: Desc)])
  @@index([result])
  @@index([session_id])
  @@index([user_id, created_at(sort: Desc)], map: "audit_logs_user_created_idx")
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model connected_google_accounts {
  id                              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                         String                            @db.Uuid
  google_subject                  String
  email                           String
  granted_scopes                  String[]                          @default([])
  access_token_ciphertext         String?
  access_token_iv                 String?
  access_token_auth_tag           String?
  refresh_token_ciphertext        String?
  refresh_token_iv                String?
  refresh_token_auth_tag          String?
  encryption_key_version          Int?
  access_token_expires_at         DateTime?                         @db.Timestamptz(6)
  last_token_refresh_at           DateTime?                         @db.Timestamptz(6)
  gmail_connected                 Boolean                           @default(false)
  connection_status               google_connection_status          @default(DISCONNECTED)
  last_connection_error_code      String?
  last_connection_error_at        DateTime?                         @db.Timestamptz(6)
  created_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  connected_at                    DateTime?                         @db.Timestamptz(6)
  disconnected_at                 DateTime?                         @db.Timestamptz(6)
  users                           users                             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  gmail_labels                    gmail_labels[]
  gmail_message_metadata          gmail_message_metadata[]
  gmail_sync_runs                 gmail_sync_runs[]
  gmail_sync_state                gmail_sync_states?
  taxonomy_plans                  taxonomy_plans[]
  activity_runs                   activity_runs[]
  automation_settings             automation_settings?
  automation_state                automation_states?
  automation_runs                 automation_runs[]
  automation_message_actions      automation_message_actions[]
  facet_pivot_settings            facet_pivot_settings?
  facet_vocabularies              facet_vocabularies[]
  learned_classification_patterns learned_classification_patterns[]
  message_facets                  message_facets[]
  user_labels                     user_labels[]

  @@unique([user_id, google_subject], map: "connected_google_accounts_user_subject_unique_idx")
  @@index([email])
  @@index([google_subject])
  @@index([connection_status], map: "connected_google_accounts_status_idx")
  @@index([access_token_expires_at], map: "connected_google_accounts_access_token_expires_at_idx")
  @@index([user_id])
}

/// Gmail label metadata only. This model contains row level security and requires migration setup.
model gmail_labels {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @db.Uuid
  gmail_label_id              String
  name                        String
  type                        String
  message_list_visibility     String?
  label_list_visibility       String?
  is_managed                  Boolean                   @default(false)
  managed_purpose             String?
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)

  @@unique([connected_google_account_id, gmail_label_id], map: "gmail_labels_account_label_unique_idx")
  @@unique([connected_google_account_id, name], map: "gmail_labels_account_name_unique_idx")
  @@index([connected_google_account_id])
  @@index([connected_google_account_id, is_managed], map: "gmail_labels_account_managed_idx")
}

/// Metadata-only Gmail message projection. No bodies, attachments, or raw MIME are stored.
model gmail_message_metadata {
  id                          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                      @db.Uuid
  gmail_message_id            String
  gmail_thread_id             String?
  history_id                  String?
  internal_date               DateTime?                   @db.Timestamptz(6)
  subject                     String?
  sender_name                 String?
  sender_email                String?
  recipient_summary           String?
  snippet                     String?
  label_ids                   String[]                    @default([])
  has_attachments             Boolean                     @default(false)
  size_estimate               Int?
  is_unread                   Boolean                     @default(false)
  is_starred                  Boolean                     @default(false)
  is_important                Boolean                     @default(false)
  is_draft                    Boolean                     @default(false)
  is_sent                     Boolean                     @default(false)
  is_trashed                  Boolean                     @default(false)
  first_seen_at               DateTime                    @default(now()) @db.Timestamptz(6)
  last_synced_at              DateTime                    @default(now()) @db.Timestamptz(6)
  deleted_at                  DateTime?                   @db.Timestamptz(6)
  created_at                  DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                    @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts   @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)
  automationAction            automation_message_actions?
  facets                      message_facets?

  @@unique([connected_google_account_id, gmail_message_id], map: "gmail_messages_account_message_unique_idx")
  @@index([connected_google_account_id])
  @@index([connected_google_account_id, gmail_thread_id], map: "gmail_messages_account_thread_idx")
  @@index([connected_google_account_id, internal_date(sort: Desc)], map: "gmail_messages_account_date_idx")
  @@index([connected_google_account_id, deleted_at], map: "gmail_messages_account_deleted_idx")
  @@index([connected_google_account_id, history_id], map: "gmail_messages_account_history_idx")
}

/// Durable sync checkpoint and expiring cross-instance lease.
model gmail_sync_states {
  id                            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id   String                    @unique(map: "gmail_sync_states_account_unique_idx") @db.Uuid
  status                        gmail_sync_status         @default(NOT_STARTED)
  last_history_id               String?
  initial_sync_completed_at     DateTime?                 @db.Timestamptz(6)
  last_sync_started_at          DateTime?                 @db.Timestamptz(6)
  last_sync_completed_at        DateTime?                 @db.Timestamptz(6)
  last_successful_sync_at       DateTime?                 @db.Timestamptz(6)
  next_retry_at                 DateTime?                 @db.Timestamptz(6)
  failure_count                 Int                       @default(0)
  last_error_code               String?
  last_error_at                 DateTime?                 @db.Timestamptz(6)
  lease_token                   String?
  lease_expires_at              DateTime?                 @db.Timestamptz(6)
  total_gmail_messages          Int?
  backfill_page_token           String?
  backfill_history_id           String?
  backfill_messages_processed   Int                       @default(0)
  backfill_pages_completed      Int                       @default(0)
  backfill_started_at           DateTime?                 @db.Timestamptz(6)
  backfill_checkpointed_at      DateTime?                 @db.Timestamptz(6)
  backfill_listing_completed_at DateTime?                 @db.Timestamptz(6)
  backfill_completed_at         DateTime?                 @db.Timestamptz(6)
  created_at                    DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts     connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lease_expires_at], map: "gmail_sync_states_lease_expiry_idx")
  @@index([next_retry_at], map: "gmail_sync_states_next_retry_idx")
}

/// Bounded operational history for safe status reporting and troubleshooting.
model gmail_sync_runs {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @db.Uuid
  sync_type                   gmail_sync_type
  status                      gmail_sync_run_status     @default(RUNNING)
  started_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  completed_at                DateTime?                 @db.Timestamptz(6)
  messages_examined           Int                       @default(0)
  messages_upserted           Int                       @default(0)
  messages_deleted            Int                       @default(0)
  labels_upserted             Int                       @default(0)
  checkpoint_history_id       String?
  error_code                  String?
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)

  @@index([connected_google_account_id, started_at(sort: Desc)], map: "gmail_sync_runs_account_started_idx")
  @@index([status])
}

/// One record per long-running operation, whatever the feature. The HTTP contract for slow work
/// is 202 plus this row's id; the client polls it instead of holding a request open.
model activity_runs {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @db.Uuid
  kind                        activity_run_kind
  state                       activity_run_state        @default(RUNNING)
  trigger                     automation_trigger        @default(MANUAL)
  processed_count             Int                       @default(0)
  total_count                 Int?
  counts                      Json                      @default("{}")
  stop_reason                 String?
  error_code                  String?
  error_message               String?
  feature_run_id              String?                   @db.Uuid
  expires_at                  DateTime                  @db.Timestamptz(6)
  started_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  finished_at                 DateTime?                 @db.Timestamptz(6)
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)

  @@index([connected_google_account_id, started_at(sort: Desc)], map: "activity_runs_account_started_idx")
  @@index([state, expires_at], map: "activity_runs_state_expiry_idx")
}

/// One model-designed folder tree awaiting human approval. Nothing here exists in Gmail yet.
model taxonomy_plans {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @db.Uuid
  status                      taxonomy_plan_status      @default(PENDING)
  model                       String
  prompt_version              String
  sampled_message_count       Int
  analyzed_message_count      Int
  leaf_count                  Int                       @default(0)
  input_tokens                Int                       @default(0)
  output_tokens               Int                       @default(0)
  estimated_cost_microusd     Int                       @default(0)
  warnings                    String[]                  @default([])
  approved_at                 DateTime?                 @db.Timestamptz(6)
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)
  nodes                       taxonomy_plan_nodes[]

  @@index([connected_google_account_id, status, created_at(sort: Desc)], map: "taxonomy_plans_account_status_idx")
}

/// A proposed folder. `full_path` is the joined ancestor chain; only leaves are created in Gmail.
model taxonomy_plan_nodes {
  id                      String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id                 String                     @db.Uuid
  parent_id               String?                    @db.Uuid
  depth                   Int
  kind                    taxonomy_node_kind
  name                    String
  full_path               String
  normalized_name         String
  rationale               String
  estimated_message_count Int
  matched_message_count   Int                        @default(0)
  is_leaf                 Boolean                    @default(true)
  position                Int                        @default(0)
  created_at              DateTime                   @default(now()) @db.Timestamptz(6)
  plan                    taxonomy_plans             @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  parent                  taxonomy_plan_nodes?       @relation("taxonomy_plan_node_tree", fields: [parent_id], references: [id], onDelete: Cascade)
  children                taxonomy_plan_nodes[]      @relation("taxonomy_plan_node_tree")
  rules                   taxonomy_plan_node_rules[]

  @@unique([plan_id, full_path], map: "taxonomy_plan_nodes_path_unique_idx")
  @@index([plan_id, depth, position], map: "taxonomy_plan_nodes_plan_idx")
  @@index([parent_id], map: "taxonomy_plan_nodes_parent_idx")
}

/// A proposed routing rule. Confirmation copies it into learned_classification_patterns.
model taxonomy_plan_node_rules {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  node_id               String              @db.Uuid
  rule_kind             routing_rule_kind
  match_value           String
  matched_message_count Int                 @default(0)
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  node                  taxonomy_plan_nodes @relation(fields: [node_id], references: [id], onDelete: Cascade)

  @@unique([node_id, rule_kind, match_value], map: "taxonomy_plan_node_rules_unique_idx")
  @@index([node_id], map: "taxonomy_plan_node_rules_node_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model oauth_states {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state_hash               String        @unique(map: "oauth_states_state_hash_unique_idx")
  purpose                  oauth_purpose
  initiating_user_id       String?       @db.Uuid
  initiating_session_id    String?       @db.Uuid
  code_verifier_ciphertext String?
  code_verifier_iv         String?
  code_verifier_auth_tag   String?
  encryption_key_version   Int?
  redirect_path            String?
  expires_at               DateTime      @db.Timestamptz(6)
  used_at                  DateTime?     @db.Timestamptz(6)
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  sessions                 sessions?     @relation(fields: [initiating_session_id], references: [id])
  users                    users?        @relation(fields: [initiating_user_id], references: [id], onDelete: Cascade)

  @@index([expires_at], map: "oauth_states_expiry_idx")
  @@index([initiating_user_id], map: "oauth_states_initiating_user_idx")
  @@index([initiating_session_id], map: "oauth_states_initiating_session_idx")
  @@index([purpose])
  @@index([used_at], map: "oauth_states_used_at_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sessions {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String         @db.Uuid
  session_token_hash String         @unique(map: "sessions_token_hash_unique_idx")
  user_agent         String?
  ip_hash            String?
  expires_at         DateTime       @db.Timestamptz(6)
  last_used_at       DateTime       @default(now()) @db.Timestamptz(6)
  revoked_at         DateTime?      @db.Timestamptz(6)
  revocation_reason  String?
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  audit_logs         audit_logs[]
  oauth_states       oauth_states[]
  users              users          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at, revoked_at], map: "sessions_cleanup_idx")
  @@index([expires_at])
  @@index([revoked_at], map: "sessions_revoked_at_idx")
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  google_subject             String                       @unique(map: "users_google_subject_unique_idx")
  email                      String
  normalized_email           String                       @unique(map: "users_normalized_email_unique_idx")
  email_verified             Boolean                      @default(false)
  display_name               String?
  avatar_url                 String?
  status                     user_status                  @default(ACTIVE)
  last_login_at              DateTime?                    @db.Timestamptz(6)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  deleted_at                 DateTime?                    @db.Timestamptz(6)
  tutorial_completed_at      DateTime?                    @db.Timestamptz(6)
  audit_logs                 audit_logs[]
  connected_google_accounts  connected_google_accounts[]
  oauth_states               oauth_states[]
  sessions                   sessions[]
  automation_message_actions automation_message_actions[]

  @@index([created_at(sort: Desc)])
  @@index([status])
}

enum audit_result {
  SUCCESS
  FAILURE
  DENIED
  INFO
}

enum google_connection_status {
  CONNECTED
  REAUTH_REQUIRED
  REVOKED
  DISCONNECTED
  ERROR
}

enum oauth_purpose {
  LOGIN
  CONNECT_GMAIL
  REAUTHORIZE_GMAIL
}

enum user_status {
  ACTIVE
  SUSPENDED
  DELETED
}

enum gmail_sync_status {
  NOT_STARTED
  INITIAL_SYNC_RUNNING
  READY
  INCREMENTAL_SYNC_RUNNING
  LABEL_SYNC_RUNNING
  FAILED
  REAUTH_REQUIRED
  HISTORY_EXPIRED
}

enum gmail_sync_type {
  INITIAL
  INCREMENTAL
  LABELS
}

enum gmail_sync_run_status {
  RUNNING
  COMPLETED
  FAILED
}

enum activity_run_kind {
  GMAIL_INITIAL_SYNC
  GMAIL_INCREMENTAL_SYNC
  GMAIL_LABEL_SYNC
  LABEL_PROPOSAL
  AUTOMATION_FILING
  FACET_CLASSIFICATION
}

enum activity_run_state {
  RUNNING
  SUCCEEDED
  STOPPED
  FAILED
}

enum taxonomy_plan_status {
  PENDING
  APPROVED
  SUPERSEDED
}

enum taxonomy_node_kind {
  CATEGORY
  TOPIC
  STATE
}

enum routing_rule_kind {
  SENDER_DOMAIN
  SENDER_ADDRESS
  SUBJECT_CONTAINS
}

enum routing_rule_source {
  PLANNER
  LEARNED
}

enum automation_run_status {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum automation_trigger {
  SCHEDULED
  MANUAL
}

enum automation_action_status {
  PENDING
  REVIEW_REQUIRED
  APPLIED
  SKIPPED
  FAILED
}

enum automation_classification_source {
  AI
  LEARNED_PATTERN
  USER
}

/// User-approved label set. Automation may only apply labels present here.
model user_labels {
  id                          String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                            @db.Uuid
  parent_id                   String?                           @db.Uuid
  depth                       Int                               @default(1)
  leaf_name                   String
  full_path                   String
  normalized_name             String
  /// The facet combination this folder holds, as "entity=netflix|intent=payment-failed". The
  /// folder's identity; the path is only how it is spelled. Null on folders the tree planner
  /// created before facets existed.
  facet_key                   String?
  rationale                   String?
  source                      user_label_source
  gmail_label_id              String?
  created_at                  DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                          @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts         @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)
  parent                      user_labels?                      @relation("user_label_tree", fields: [parent_id], references: [id], onDelete: Cascade)
  children                    user_labels[]                     @relation("user_label_tree")
  routing_rules               learned_classification_patterns[]

  @@unique([connected_google_account_id, full_path], map: "user_labels_account_path_unique_idx")
  // Names are unique among siblings, and facet keys unique per account; both indexes carry
  // predicates or expressions Prisma cannot express, so they are created in SQL.
  @@index([connected_google_account_id, created_at(sort: Desc)], map: "user_labels_account_created_idx")
  @@index([connected_google_account_id, depth], map: "user_labels_account_depth_idx")
  @@index([parent_id], map: "user_labels_parent_idx")
}

enum user_label_source {
  AI_PROPOSED
  USER_CREATED
}

/// Per-account daily automation policy. Secrets and provider credentials are never stored here.
model automation_settings {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @unique(map: "automation_settings_account_unique_idx") @db.Uuid
  enabled                     Boolean                   @default(true)
  schedule_hour_utc           Int                       @default(2)
  confidence_threshold        Float                     @default(0.8)
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)
}

/// Expiring lease and recovery checkpoint for cross-instance-safe automation.
model automation_states {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @unique(map: "automation_states_account_unique_idx") @db.Uuid
  lease_token                 String?
  lease_expires_at            DateTime?                 @db.Timestamptz(6)
  active_run_id               String?                   @db.Uuid
  next_run_at                 DateTime?                 @db.Timestamptz(6)
  last_run_started_at         DateTime?                 @db.Timestamptz(6)
  last_run_completed_at       DateTime?                 @db.Timestamptz(6)
  last_successful_run_at      DateTime?                 @db.Timestamptz(6)
  failure_count               Int                       @default(0)
  last_error_code             String?
  retry_at                    DateTime?                 @db.Timestamptz(6)
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)

  @@index([lease_expires_at], map: "automation_states_lease_expiry_idx")
  @@index([next_run_at], map: "automation_states_next_run_idx")
  @@index([retry_at], map: "automation_states_retry_idx")
}

/// One bounded, auditable attempt to classify and apply Gmail labels.
model automation_runs {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                       @db.Uuid
  idempotency_key             String                       @unique(map: "automation_runs_idempotency_unique_idx")
  trigger                     automation_trigger
  status                      automation_run_status        @default(RUNNING)
  messages_seen               Int                          @default(0)
  pattern_reused_count        Int                          @default(0)
  ai_classified_count         Int                          @default(0)
  review_required_count       Int                          @default(0)
  no_label_skipped_count      Int                          @default(0)
  backlog_remaining           Int                          @default(0)
  labels_created_count        Int                          @default(0)
  labels_reused_count         Int                          @default(0)
  messages_labeled_count      Int                          @default(0)
  failed_count                Int                          @default(0)
  provider_call_count         Int                          @default(0)
  input_tokens                Int                          @default(0)
  cached_input_tokens         Int                          @default(0)
  output_tokens               Int                          @default(0)
  estimated_cost_microusd     Int                          @default(0)
  stopped_reason              String?
  last_error_code             String?
  last_provider_status        Int?
  last_provider_code          String?
  last_provider_request_id    String?
  started_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  completed_at                DateTime?                    @db.Timestamptz(6)
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts    @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)
  actions                     automation_message_actions[]

  @@index([connected_google_account_id, started_at(sort: Desc)], map: "automation_runs_account_started_idx")
  @@index([status, started_at], map: "automation_runs_status_started_idx")
}

/// Durable message-level idempotency record; Gmail writes may be safely retried.
model automation_message_actions {
  id                          String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automation_run_id           String                           @db.Uuid
  connected_google_account_id String                           @db.Uuid
  gmail_message_id            String                           @unique(map: "automation_actions_message_unique_idx") @db.Uuid
  user_id                     String                           @db.Uuid
  status                      automation_action_status         @default(PENDING)
  label_name                  String
  /// Null exactly when label_name is the NONE sentinel: nothing was filed, so there is no path.
  label_path                  String?
  gmail_label_id              String?
  confidence                  Float
  source                      automation_classification_source
  explanation                 String
  reason_codes                String[]                         @default([])
  input_hash                  String
  attempt_count               Int                              @default(0)
  next_retry_at               DateTime?                        @db.Timestamptz(6)
  last_error_code             String?
  applied_at                  DateTime?                        @db.Timestamptz(6)
  reviewed_at                 DateTime?                        @db.Timestamptz(6)
  created_at                  DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                         @default(now()) @db.Timestamptz(6)
  run                         automation_runs                  @relation(fields: [automation_run_id], references: [id], onDelete: Cascade)
  connected_google_accounts   connected_google_accounts        @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)
  message                     gmail_message_metadata           @relation(fields: [gmail_message_id], references: [id], onDelete: Cascade)
  user                        users                            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([automation_run_id, status], map: "automation_actions_run_status_idx")
  @@index([connected_google_account_id, status, created_at(sort: Desc)], map: "automation_actions_review_idx")
  // A partial retry index is created in SQL because Prisma cannot express its predicate.
  @@index([user_id, created_at(sort: Desc)], map: "automation_actions_user_created_idx")
}

/// Learned sender-domain outcome used only after enough successful examples.
model learned_classification_patterns {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @db.Uuid
  rule_kind                   routing_rule_kind         @default(SENDER_DOMAIN)
  match_value                 String
  rule_source                 routing_rule_source       @default(LEARNED)
  user_label_id               String?                   @db.Uuid
  priority                    Int                       @default(100)
  /// Null only on a facet-only rule: which folder a facet pair becomes is a pivot decision that
  /// has not been made yet, and a placeholder path would name a folder that does not exist. Every
  /// pre-existing rule keeps both values, so the filing path is unchanged.
  label_name                  String?
  label_path                  String?
  /// Null on rules written before facets existed; their arrival must not invalidate those.
  facet_domain                String?
  facet_intent                String?
  /// The brand whose mail taught this rule, so a hit on any other one is countably cross-entity.
  learned_from_entity         String?
  confidence                  Float
  sample_count                Int                       @default(1)
  successful_apply_count      Int                       @default(0)
  active                      Boolean                   @default(true)
  last_used_at                DateTime?                 @db.Timestamptz(6)
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)
  user_label                  user_labels?              @relation(fields: [user_label_id], references: [id], onDelete: Cascade)
  // A partial index over facet-bearing rules is created in SQL; Prisma cannot express its predicate.

  @@unique([connected_google_account_id, rule_kind, match_value], map: "learned_patterns_account_rule_unique_idx")
  @@index([connected_google_account_id, active, confidence], map: "learned_patterns_reuse_idx")
  @@index([user_label_id], map: "learned_patterns_account_label_idx")
}

/// One row per message: the three facets it was assigned, and how each was decided.
///
/// This row is also the checkpoint — a resumed classification pass skips every message that has
/// one — which is why the unique index is on the message rather than on the run.
model message_facets {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @db.Uuid
  gmail_message_id            String                    @unique(map: "message_facets_message_unique_idx") @db.Uuid
  /// Derived from sender_email, so null exactly when the sender carries no usable domain.
  entity                      String?
  domain                      String?
  intent                      String?
  entity_confidence           Float                     @default(1)
  domain_confidence           Float?
  intent_confidence           Float?
  source                      facet_source
  prompt_version              String
  input_hash                  String
  classified_at               DateTime                  @default(now()) @db.Timestamptz(6)
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)
  message                     gmail_message_metadata    @relation(fields: [gmail_message_id], references: [id], onDelete: Cascade)

  @@index([connected_google_account_id, classified_at(sort: Desc)], map: "message_facets_account_classified_idx")
  @@index([connected_google_account_id, entity, intent], map: "message_facets_account_entity_intent_idx")
  @@index([connected_google_account_id, domain, intent], map: "message_facets_account_domain_intent_idx")
}

/// Rate-limit counters, shared by every API instance. One row per (key, window): a new window is
/// a new row, so two instances incrementing the same client both land on an atomic upsert rather
/// than racing over a value one of them read a moment ago.
model rate_limit_hits {
  key          String
  window_start DateTime @db.Timestamptz(6)
  window_ms    Int
  hits         Int      @default(0)
  expires_at   DateTime @db.Timestamptz(6)

  @@id([key, window_start, window_ms])
  @@index([expires_at], map: "rate_limit_hits_expiry_idx")
}

/// The domains and intents ONE mailbox owner approved. A vocabulary belongs to a mailbox, not to
/// the repository: "career, finance, education" is the right set for the mailbox it was designed
/// from and nobody else's.
model facet_vocabularies {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @db.Uuid
  /// Only the two model facets. `entity` is derived in code and is never a vocabulary.
  facet                       String
  name                        String
  /// One sentence, precise enough to route by. Sent to the model verbatim.
  definition                  String
  status                      facet_vocabulary_status   @default(PROPOSED)
  position                    Int                       @default(0)
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)

  @@unique([connected_google_account_id, facet, status, name], map: "facet_vocabularies_account_value_unique_idx")
  @@index([connected_google_account_id, status], map: "facet_vocabularies_account_status_idx")
}

/// Whether a value is a pending proposal or the vocabulary the classifier may actually speak.
enum facet_vocabulary_status {
  PROPOSED
  APPROVED
}

/// The account's canonical facet ordering: which pivot is materialised into folders and Gmail.
/// Every other ordering is computed on read and never leaves the database.
model facet_pivot_settings {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connected_google_account_id String                    @unique @db.Uuid
  /// Ordered: the first facet is the top level of the tree.
  canonical_pivot             String[]                  @default(["entity", "intent"])
  min_messages                Int                       @default(5)
  created_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                  @default(now()) @db.Timestamptz(6)
  connected_google_accounts   connected_google_accounts @relation(fields: [connected_google_account_id], references: [id], onDelete: Cascade)
}

/// Which mechanism decided a message's domain and intent. Entity is always derived.
enum facet_source {
  RULE
  MODEL
}
