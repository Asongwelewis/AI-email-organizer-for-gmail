NODE_ENV=development
APP_VERSION=mailmind@0.1.0
# Public project DSN. Leave empty to disable Sentry cleanly.
SENTRY_DSN=https://781bd2f2c6332e6cd11e962397f78648@o4511812817715200.ingest.us.sentry.io/4511812833771520
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_DEBUG=false
# Build-only source-map upload values. Never expose the auth token to browser code.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# Supabase Dashboard > Connect
# Use the shared Session Pooler (port 5432) for this persistent API and migrations.
# URL-encode the dedicated Prisma role password before inserting it.
# Cold projects may take several seconds to wake; keep the bounded timeout parameters.
DATABASE_URL="postgresql://prisma.PROJECT_REF:YOUR_PRISMA_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30&pool_timeout=60&connection_limit=1"
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
TOKEN_ENCRYPTION_KEY_VERSION=1
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
ACCESS_SESSION_TTL_MINUTES=15
REFRESH_SESSION_TTL_DAYS=14
OAUTH_STATE_TTL_MINUTES=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=10
AUTH_RATE_LIMIT_MAX_REQUESTS=30
GMAIL_SYNC_PAGE_SIZE=100
GMAIL_SYNC_BATCH_SIZE=10
GMAIL_SYNC_MAX_RETRIES=3
GMAIL_SYNC_RETRY_BASE_MS=250
GMAIL_SYNC_LEASE_SECONDS=300

# Stage 4.5 metadata-only dynamic label discovery. Gmail messages and labels are not changed.
DYNAMIC_LABEL_DISCOVERY_ENABLED=true
DYNAMIC_LABEL_MIN_MESSAGES=3
DYNAMIC_LABEL_LOOKBACK_DAYS=90
DYNAMIC_LABEL_MIN_CONFIDENCE=0.75
DYNAMIC_LABEL_MIN_CATEGORY_AGREEMENT=0.70
DYNAMIC_LABEL_MIN_SOURCE_AGREEMENT=0.70
DYNAMIC_LABEL_MAX_CANDIDATES_PER_RUN=20
DYNAMIC_LABEL_MAX_MESSAGES_PER_RUN=1000
DYNAMIC_LABEL_MAX_PENDING_CANDIDATES=50
DYNAMIC_LABEL_MAX_APPROVED_LABELS=100
DYNAMIC_LABEL_REDISCOVERY_DAYS=14
DYNAMIC_LABEL_AI_NAMING_ENABLED=false
AUTOMATION_ENABLED=true
AUTOMATION_SCHEDULE_HOUR_UTC=2
AUTOMATION_POLL_INTERVAL_MINUTES=15
AUTOMATION_LEASE_SECONDS=1800
AUTOMATION_BATCH_SIZE=10
AUTOMATION_MAX_MESSAGES_PER_RUN=250
AUTOMATION_MAX_LABELS=25
AUTOMATION_MAX_INPUT_TOKENS=100000
AUTOMATION_MAX_OUTPUT_TOKENS=10000
AUTOMATION_MAX_COST_MICRO_USD=500000
AUTOMATION_CONFIDENCE_THRESHOLD=0.80
AUTOMATION_PATTERN_MIN_SAMPLES=2
AUTOMATION_PATTERN_MIN_CONFIDENCE=0.90
AUTOMATION_MAX_ACTION_RETRIES=3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
OPENAI_INPUT_COST_PER_MILLION_MICRO_USD=5000000
OPENAI_CACHED_INPUT_COST_PER_MILLION_MICRO_USD=500000
OPENAI_OUTPUT_COST_PER_MILLION_MICRO_USD=30000000
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_LOGIN_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
GOOGLE_GMAIL_REDIRECT_URI="http://localhost:4000/api/integrations/google/callback"
