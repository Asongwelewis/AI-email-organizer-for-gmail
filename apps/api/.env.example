NODE_ENV=development
APP_VERSION=mailmind@0.1.0
# Public project DSN. Leave empty to disable Sentry cleanly.
SENTRY_DSN=https://781bd2f2c6332e6cd11e962397f78648@o4511812817715200.ingest.us.sentry.io/4511812833771520
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_DEBUG=false
# Build-only source-map upload values. Never expose the auth token to browser code.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# Supabase Dashboard > Connect
# Use the shared Session Pooler (port 5432) for this persistent API and migrations.
# URL-encode the dedicated Prisma role password before inserting it.
# Cold projects may take several seconds to wake; keep the bounded timeout parameters.
DATABASE_URL="postgresql://prisma.PROJECT_REF:YOUR_PRISMA_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30&pool_timeout=60"
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
TOKEN_ENCRYPTION_KEY_VERSION=1
COOKIE_SECURE=false
COOKIE_DOMAIN=
# 'lax' is right for local development, where the SPA and API share localhost.
# Production MUST use 'none': the SPA (Vercel) and API (Render) are different
# sites, so a lax or strict cookie is never sent and login fails silently.
# Startup validation rejects anything but 'none' in production unless
# COOKIE_DOMAIN is set to a parent domain shared by both.
COOKIE_SAME_SITE=lax
# Sliding: a session expires after this many days WITHOUT use; use pushes it forward.
REFRESH_SESSION_TTL_DAYS=30
# Hard ceiling from sign-in that no amount of use extends.
SESSION_MAX_LIFETIME_DAYS=90
# Prisma pool size (default 5). Overrides any connection_limit in DATABASE_URL.
DATABASE_CONNECTION_LIMIT=
# Idle `select 1` interval in seconds while the API is awake; 0 disables.
DATABASE_HEARTBEAT_SECONDS=240
# Apply pending migrations on boot. Defaults to true in production, false elsewhere.
MIGRATE_ON_START=
OAUTH_STATE_TTL_MINUTES=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=10
AUTH_RATE_LIMIT_MAX_REQUESTS=30
GMAIL_SYNC_PAGE_SIZE=100
GMAIL_SYNC_BATCH_SIZE=10
GMAIL_SYNC_MAX_RETRIES=3
GMAIL_SYNC_RETRY_BASE_MS=250
GMAIL_SYNC_LEASE_SECONDS=300

# Whether MailMind may write labels into the mailbox. Off by default: the PWA reads its folders
# from the stored facets, and a message's deep link resolves by id whether or not it is labelled.
# Turn this on only to also mirror the folders into Gmail's own label sidebar.
GMAIL_WRITE_ENABLED=false

# Stage 4.5 metadata-only dynamic label discovery. Gmail messages and labels are not changed.
TAXONOMY_SAMPLE_SIZE=500
TAXONOMY_LOOKBACK_DAYS=365
TAXONOMY_MAX_MESSAGES=5000
TAXONOMY_MAX_OUTPUT_TOKENS=16000

# Facet vocabulary design. Read-only: it proposes vocabularies and creates nothing.
FACET_LOOKBACK_DAYS=3650
FACET_MAX_MESSAGES=20000
FACET_SAMPLE_SIZE=700
FACET_SAMPLE_PER_DOMAIN_CAP=4
FACET_SAMPLE_UNFILED_SHARE=0.8
FACET_MAX_OUTPUT_TOKENS=16000
AUTOMATION_ENABLED=true
# Full runs (backlog, re-classification, filing) start at these UTC hours.
AUTOMATION_FULL_RUN_HOURS_UTC=2,14
AUTOMATION_POLL_INTERVAL_MINUTES=15
# The watcher: ask Gmail for new mail this often (seconds; 0 turns it off) and sort it as it lands.
AUTOMATION_CHECK_INTERVAL_SECONDS=60
# New mail the rules cannot settle waits for Gemini until this many queue, or the oldest waits this long.
AUTOMATION_CLASSIFY_BATCH_THRESHOLD=10
AUTOMATION_CLASSIFY_MAX_WAIT_MINUTES=5
# Production only: request our own public /health this often so the free plan never sleeps (0 = off).
KEEP_AWAKE_INTERVAL_MINUTES=10
# Web Push for new-mail notifications in the OS notification centre. Generate the pair once with
# `npx web-push generate-vapid-keys`; set both or neither. The subject is how a push service
# reaches us: a mailto: or https: URL (defaults to WEB_APP_URL when that is https).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
AUTOMATION_LEASE_SECONDS=1800
AUTOMATION_BATCH_SIZE=10
AUTOMATION_MAX_MESSAGES_PER_RUN=250
AUTOMATION_MAX_LABELS=40
AUTOMATION_MAX_INPUT_TOKENS=1000000
AUTOMATION_MAX_OUTPUT_TOKENS=100000
AUTOMATION_MAX_COST_MICRO_USD=5000000
AUTOMATION_CONFIDENCE_THRESHOLD=0.80
AUTOMATION_PATTERN_MIN_SAMPLES=2
AUTOMATION_PATTERN_MIN_CONFIDENCE=0.90
AUTOMATION_MAX_ACTION_RETRIES=3
# Gemini powers automation classification. Create a key at https://aistudio.google.com/apikey.
# GEMINI_API_KEY is a backend-only secret; automation stays disabled while it is empty.
# GEMINI_MODEL uses the flash-lite alias on purpose: pinned ids get retired (gemini-2.5-flash-lite
# began returning 404 "no longer available to new users"). Google no longer publishes per-model
# free-tier limits — check yours at https://aistudio.google.com/rate-limit.
# GEMINI_MIN_REQUEST_INTERVAL_MS=4000 paces calls to 15/minute instead of relying on 429 retries.
# NOTE: on Google's free tier, submitted content may be used to improve Google's products.
# That is acceptable for single-user personal use only — see docs/backend.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_MIN_REQUEST_INTERVAL_MS=4000
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_LOGIN_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
GOOGLE_GMAIL_REDIRECT_URI="http://localhost:4000/api/integrations/google/callback"
